{
  "name": "matematica-delicada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply matematica-delicada-local --local -c wrangler.local.jsonc",
    "worker:dev": "wrangler dev --port 8788 -c wrangler.local.jsonc",
    "worker:preview": "npm run build && npm run db:migrate:local && npm run worker:dev",
    "screenshots": "playwright test evidence/screenshots.spec.ts",
    "test:e2e": "playwright test",
    "worker:check": "tsc -p worker/tsconfig.json",
    "check:deploy-config": "node scripts/check-deployable-d1-config.mjs",
    "bench:pbkdf2": "node worker/scripts/benchmark-pbkdf2.mjs",
    "predeploy": "npm run check:deploy-config",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
